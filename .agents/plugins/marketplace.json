{
  "name": "cloudcodex-helpers",
  "interface": {
    "displayName": "CloudCodeX Helpers"
  },
  "plugins": [
    {
      "name": "cloudcodex-windows-bootstrap",
      "source": {
        "source": "git-subdir",
        "url": "https://github.com/Tungsteno74/cloudcodex-windows-bootstrap.git",
        "path": "./plugins/cloudcodex-windows-bootstrap",
        "ref": "main"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Developer Tools"
    },
    {
      "name": "cloudcodex-environment-discovery",
      "source": {
        "source": "git-subdir",
        "url": "https://github.com/Tungsteno74/cloudcodex-environment-discovery.git",
        "path": "./plugins/cloudcodex-environment-discovery",
        "ref": "main"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Developer Tools"
    },
    {
      "name": "cloudrepo-environment-direct",
      "source": {
        "source": "git-subdir",
        "url": "https://github.com/Tungsteno74/cloudrepo-environment-direct.git",
        "path": "./plugins/cloudrepo-environment-direct",
        "ref": "main"
      },
      "policy": {
        "installation": "AVAILABLE",
        "authentication": "ON_INSTALL"
      },
      "category": "Developer Tools"
    }
  ]
}
